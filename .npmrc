# Do not auto-install peer dependencies.
#
# @prisma/client declares the `prisma` CLI as an optional peer. npm 7+ installs
# optional peers automatically and records them as PRODUCTION in the lockfile,
# overriding our devDependencies placement. That put ~120 MB of build tooling -
# and its CVEs - into the production dependency graph of every service.
#
# With this off, `prisma` is installed solely because devDependencies asks for
# it, and is correctly flagged dev.
legacy-peer-deps=true
