# Copy to .env and fill in. .env is gitignored - never commit real values.
#
# Supabase -> Project Settings -> Database -> Connection string
#
# DATABASE_URL: "Transaction pooler" (port 6543). Used at runtime.
#   Append ?pgbouncer=true&connection_limit=1&schema=shipments
# DIRECT_URL:   "Direct connection" (port 5432). Used only by `prisma migrate`.
#   Append ?schema=shipments

DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=shipments"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=shipments"

KAFKA_BROKERS="localhost:9092"
PORT=3002
LOG_LEVEL=debug
